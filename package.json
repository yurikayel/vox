{
  "name": "vox",
  "version": "0.5.0",
  "license": "AGPL-3.0-or-later",
  "description": "Vox — Rede social comunitária no permaweb",
  "type": "module",
  "scripts": {
    "start": "python relay/signaling.py",
    "test:client": "node --test tests/*.test.js",
    "test:relay": "python -m unittest discover -s relay -p \"test_*.py\"",
    "test:js": "npm run test:client",
    "test:py": "npm run test:relay",
    "test:all": "npm test",
    "test": "node --test tests/*.test.js && python -m unittest discover -s relay -p \"test_*.py\"",
    "lint": "eslint \"client/js/**/*.js\" client/sw.js",
    "lint:all": "eslint \"client/js/**/*.js\" client/sw.js \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"tools/media-bench/**/*.js\" \"tests/**/*.js\"",
    "validate": "npm run lint && npm run lint:relay && npm run audit:complexity && npm test",
    "lint:fix": "eslint \"client/js/**/*.js\" client/sw.js --fix",
    "lint:relay": "python scripts/lint_relay.py",
    "audit:complexity": "node scripts/complexity-audit.mjs",
    "release-line": "python scripts/release_line.py",
    "release-metadata": "python scripts/release_line.py --metadata-only"
  },
  "devDependencies": {
    "@jsquash/avif": "2.1.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
