{
  "name": "vox",
  "version": "0.5.0",
  "license": "AGPL-3.0-or-later",
  "description": "Vox — Rede social comunitária no permaweb",
  "type": "module",
  "scripts": {
    "start": "python relay/signaling.py",
    "test:client": "node --test tests/*.test.js",
    "test:mutation:pm112": "stryker run",
    "test:relay": "python -m unittest discover -s relay -p \"test_*.py\"",
    "test:e2e": "python -m unittest discover -s e2e -p \"test_*.py\" -v",
    "test:js": "npm run test:client",
    "test:py": "npm run test:relay",
    "test:all": "npm test",
    "coverage": "npm run coverage:js && npm run coverage:py",
    "coverage:js": "node scripts/coverage.mjs",
    "coverage:py": "python scripts/py_coverage.py",
    "test": "node --test tests/*.test.js && python -m unittest discover -s relay -p \"test_*.py\"",
    "lint": "eslint \"client/js/**/*.js\" client/sw.js \"workers/**/*.js\"",
    "lint:all": "eslint \"client/js/**/*.js\" client/sw.js \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"tools/media-bench/**/*.js\" \"tests/**/*.js\"",
    "validate": "npm run lint:all && node scripts/shell-budget-check.mjs && node scripts/secrets-audit.mjs && npm run lint:relay && npm run audit:complexity && npm run audit:docs && npm run audit:internal -- --check && npm run audit:layers && npm run audit:symbols && npm test",
    "lint:fix": "eslint \"client/js/**/*.js\" client/sw.js --fix",
    "lint:relay": "python scripts/lint_relay.py",
    "audit:complexity": "node scripts/complexity-audit.mjs",
    "audit:docs": "node scripts/docs-audit.mjs",
    "audit:e2e": "node scripts/e2e-inventory.mjs",
    "audit:internal": "node scripts/internal-audit.mjs",
    "audit:layers": "node scripts/layers-audit.mjs && node scripts/cycles-audit.mjs",
    "audit:symbols": "node scripts/symbol-ratchet.mjs",
    "audit:mutate:tier-a": "node scripts/mutate-tier-a.mjs",
    "release-line": "python scripts/release_line.py",
    "release-metadata": "python scripts/release_line.py --metadata-only"
  },
  "devDependencies": {
    "@jsquash/avif": "2.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "qs": "^6.16.2",
    "minimatch": "^11.0.9"
  }
}
