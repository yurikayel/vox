[Unit]
Description=Vox Farol — Verificação Periódica de Saúde e Telemetria Local
Documentation=https://github.com/yurikayel/vox
After=vox-farol.service

[Service]
Type=oneshot
User=vox-farol
Group=vox-farol
WorkingDirectory=/opt/vox-farol
ExecStart=/opt/vox-farol/health-check.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vox-farol-health
