{
  "nodeName": "Vox Farol Comunitário",
  "version": "0.1.0",
  "role": "lighthouse",
  "network": {
    "listenHost": "127.0.0.1",
    "listenPort": 3921,
    "enableLanDiscovery": true,
    "enablePublicInbound": false
  },
  "resources": {
    "maxStorageMb": 2048,
    "maxBandwidthMonthlyGb": 50,
    "maxCpuPercent": 40
  },
  "storage": {
    "cacheDir": "/var/lib/vox-farol/cache",
    "logDir": "/var/log/vox-farol"
  },
  "services": {
    "relay": true,
    "seeder": true,
    "healthCheckIntervalSec": 300
  },
  "communities": [
    "comunidade_livre"
  ]
}
