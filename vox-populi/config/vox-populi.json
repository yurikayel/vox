{
  "nodeName": "Vox Populi Comunitário",
  "version": "0.1.1",
  "role": "community-node",
  "network": {
    "mode": "loopback-only",
    "listenHost": "127.0.0.1",
    "listenPort": 3921,
    "lanDiscovery": "not_implemented",
    "publicInbound": false
  },
  "resources": {
    "maxStorageMb": 2048,
    "maxBandwidthMonthlyGb": 50,
    "maxCpuPercent": 40
  },
  "storage": {
    "cacheDir": "/var/lib/vox-populi/cache",
    "logDir": "/var/log/vox-populi"
  },
  "services": {
    "relay": true,
    "seeder": false,
    "healthCheckIntervalSec": 300
  },
  "communities": [
    "comunidade_livre"
  ]
}
