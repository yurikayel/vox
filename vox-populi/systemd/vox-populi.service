[Unit]
Description=Vox Populi — Nó Comunitário de Relay e Cache Local
Documentation=https://github.com/yurikayel/vox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vox-populi
Group=vox-populi
WorkingDirectory=/opt/vox-populi
Environment="VOX_RELAY_CACHE_DIR=/var/lib/vox-populi/cache"
Environment="VOX_RELAY_MAX_CACHE_MB=2048"
Environment="VOX_RELAY_PORT=3921"
ExecStart=/usr/bin/python3 -m relay.server --port 3921 --host 127.0.0.1
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

# Limites de Recursos Efetivos (cgroups)
CPUQuota=40%
MemoryMax=512M
TasksMax=100

# Isolamento e Segurança do Processo
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
StateDirectory=vox-populi
LogsDirectory=vox-populi
ReadWritePaths=/var/lib/vox-populi /var/log/vox-populi /opt/vox-populi/monitoring

# Gestão de Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vox-populi

[Install]
WantedBy=multi-user.target
