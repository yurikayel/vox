# Copie para .env ao lado de docker-compose.yml (docker compose lê variáveis do shell ou .env na pasta)

# Quota soft de disco para cache tx + espelhos (MB). Default no compose: 512.
VOX_RELAY_MAX_CACHE_MB=512

# Após subir: curl -sS https://SEU_DOMINIO/health | jq '.cacheBytes, .maxCacheBytes, .communityIndexes'
